# Local development. Run `npm run setup` at the project root to generate a JWT secret.
#
# PRODUCTION (Render): do not upload this file. Enter each value in the
# Render dashboard → Environment instead. Required there:
#   NODE_ENV=production, DATABASE_URL (Neon), JWT_SECRET (new, random),
#   CORS_ORIGIN (the exact https:// Vercel URL, no trailing slash),
#   OTP_HMAC_SECRET (new, random), EMAIL_PROVIDER + its keys,
#   SMS_PROVIDER + its keys. PORT is set by Render automatically.
#   Never set the seed-only variables (ADMIN_*, DEMO_*, ALLOW_DEMO_SEED) there.
PORT=8000
DATABASE_URL=postgresql://user:password@localhost:5432/cravio
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Mobile-wallet references are manual reconciliation, NOT a live payment gateway.
# Keep disabled until you have an operational verification process.
ALLOW_MANUAL_PAYMENTS=false

# Optional — only read by scripts/seedAdmin.js
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PHONE=01700000000

# Demonstration data must never be loaded into your production database.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=

# Separate disposable database used by `npm run test:backend`.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/cravio_test

# Road routing for the live tracking map (OSRM). The free public demo server
# needs no key. Point this at a self-hosted OSRM if you have one.
OSRM_BASE_URL=https://router.project-osrm.org

# Optional live Google Places directory; server-only key, never use a VITE_ variable.
ENABLE_GOOGLE_PLACES=false
GOOGLE_PLACES_API_KEY=

# ---- Signup verification (email + phone OTP) ----
# Key for hashing OTP codes before they are stored. Separate from JWT_SECRET.
# `npm run setup` fills it in; otherwise use 32+ random characters.
OTP_HMAC_SECRET=replace-with-another-32-random-characters

# Providers. "outbox" (the default outside production) sends nothing: codes
# are written to backend/.dev-outbox/outbox.jsonl for local testing.
# The server refuses to start with "outbox" when NODE_ENV=production.
EMAIL_PROVIDER=outbox
SMS_PROVIDER=outbox

# Phone OTP is required unless this is "false". With "false" only the email
# code is needed, no SMS is sent, the phone stays unverified, and no SMS
# provider has to be configured. (Production runs with "false" until an SMS
# gateway account exists.)
PHONE_OTP_REQUIRED=true

# EMAIL_PROVIDER=brevo — Brevo's HTTPS API. Use this on Render: it needs
# no SMTP port, which free hosting tiers often block.
BREVO_API_KEY=

# EMAIL_PROVIDER=smtp — any SMTP service (Brevo SMTP, Gmail app password, ...).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Used by both smtp and brevo. Must be a sender address your provider has verified.
EMAIL_FROM="Cravio <no-reply@example.com>"

# SMS_PROVIDER=bulksmsbd — Bangladeshi SMS gateway (bulksmsbd.net).
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
