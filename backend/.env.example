# Local development. Run `npm run setup` at the project root to generate a JWT secret.
PORT=8000
DATABASE_URL=postgresql://user:password@localhost:5432/cravio
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Mobile-wallet references are manual reconciliation, NOT a live payment gateway.
# Keep disabled until you have an operational verification process.
ALLOW_MANUAL_PAYMENTS=false

# Optional — only read by scripts/seedAdmin.js
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PHONE=01700000000

# Demonstration data must never be loaded into your production database.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=

# Separate disposable database used by `npm run test:backend`.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/cravio_test

# Optional live Google Places directory; server-only key, never use a VITE_ variable.
ENABLE_GOOGLE_PLACES=false
GOOGLE_PLACES_API_KEY=
